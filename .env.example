# Backend (never commit real values)
COSMOS_URL=http://<nebius-vm-public-ip>:8000/v1   # vLLM on Nebius AI Cloud, Containers over VM
COSMOS_KEY=<vllm api key from the Nebius console>
COSMOS_MODEL=nvidia/Cosmos-Reason2-8B
TF_KEY=<Nebius Token Factory API key>
NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b   # confirm with GET /v1/models
TAVILY_KEY=<tavily api key>
ALLOWED_ORIGINS=http://localhost:3000
# Calibration knobs, set from the eval dev split (they only ever widen the upper bound)
HIGH_MARGIN_CM=0
HIGH_SCALE=1.0
# Data harvest only (scripts/harvest_flickr.py), free non-commercial key
FLICKR_KEY=<flickr api key>
